# =============================================================================
# ONEHEALTH AI - ENVIRONMENT CONFIGURATION FOR SUPABASE & FASTAPI
# =============================================================================

# Server Port
PORT=8000

# -----------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE URL
# Find in Supabase Dashboard -> Project Settings -> Database -> Connection string
# -----------------------------------------------------------------------------
# For Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# For Connection Pooling (Port 6543 / Recommended for Serverless & Multiple Clients):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Local SQLite Fallback:
DATABASE_URL=sqlite:///./onehealth.db

# -----------------------------------------------------------------------------
# 2. SUPABASE API KEYS (Optional for Direct Python Client / Storage)
# Find in Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Anon/Public key (safe to expose in client-side code, used for Auth)
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
